{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["answerable", "reference_answer", "gold_source_ids", "gold_evidence", "required_facts", "forbidden_facts", "decision", "reason"],
  "properties": {
    "answerable": {"type": "boolean"}, "reference_answer": {"type": "string", "minLength": 1},
    "gold_source_ids": {"type": "array", "items": {"type": "string"}},
    "gold_evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["document_id", "section_id", "quote"], "properties": {"document_id": {"type": "string"}, "section_id": {"type": "string"}, "quote": {"type": "string", "minLength": 1}}}},
    "required_facts": {"type": "array", "items": {"type": "string"}}, "forbidden_facts": {"type": "array", "items": {"type": "string"}},
    "decision": {"enum": ["accept", "reject"]}, "reason": {"type": "string", "minLength": 1}
  }
}
