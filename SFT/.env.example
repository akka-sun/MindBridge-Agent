# DeepSeek v4 compatible API. Replace values with the provider's official settings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://your-provider.example/v1
DEEPSEEK_MODEL=deepseek-v4
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=3

# Local/Hugging Face model used for baseline and QLoRA.
BASE_MODEL_PATH=/path/to/Qwen2.5-7B-Instruct
HF_TOKEN=

# Reproducibility.
SFT_RANDOM_SEED=20260905
TOKENIZERS_PARALLELISM=false
PYTHONUTF8=1

